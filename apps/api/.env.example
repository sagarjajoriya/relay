NODE_ENV=development
PORT=4000

# postgresql://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql://relay:relay@localhost:5432/relay

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-32-byte-hex-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

CORS_ORIGIN=http://localhost:3002

REDIS_URL=redis://localhost:6379

# S3-compatible object storage (MinIO locally: `minio server ~/minio-data`)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=relay-attachments
